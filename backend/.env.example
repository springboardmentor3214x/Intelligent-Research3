# =================================================================
# Environment Configuration
# =================================================================
APP_ENV=development

# =================================================================
# Database Configuration (Supabase PostgreSQL)
# Format: postgresql://postgres.[project-ref]:[password]@[host]:6543/postgres
# =================================================================
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# =================================================================
# Security & JWT Authentication
# Generate a secure key using: python -c "import secrets; print(secrets.token_hex(32))"
# =================================================================
SECRET_KEY=your-super-secret-jwt-key-min-32-chars-long
JWT_SECRET_KEY=your-super-secret-jwt-key-min-32-chars-long
ALGORITHM=HS256
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# =================================================================
# CORS & Frontend URLs (Comma-separated for multiple origins)
# =================================================================
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
FRONTEND_URL=http://localhost:5173

# =================================================================
# Google OAuth2 Authentication (Optional)
# Obtain credentials from Google Cloud Console: https://console.cloud.google.com
# =================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback

