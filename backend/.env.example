# =================================================================
# Environment Configuration
# =================================================================
APP_ENV=development

# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/intelliresearch
# SQLite alternative for local development:
# DATABASE_URL=sqlite:///./intelliresearch.db

# ── Auth (Module 1) ────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-secret
JWT_SECRET_KEY=change-me-to-a-long-random-secret
ALGORITHM=HS256
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS & Frontend URLs ───────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
FRONTEND_URL=http://localhost:5173

# ── Google OAuth2 Authentication ───────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback

# ── Module 3 — Research Data Ingestion (OpenAlex) ──────────────────────────────
OPENALEX_MAILTO=your@email.com

# ── Funding Source APIs (Module 4) ─────────────────────────────────────────────
NIH_REPORTER_BASE_URL=https://api.reporter.nih.gov/v2
GRANTS_GOV_BASE_URL=https://apply07.grants.gov/grantsws
FUNDING_SYNC_DEFAULT_LIMIT=50
FUNDING_SYNC_TIMEOUT_SECONDS=30
FUNDING_SYNC_MAX_RETRIES=3

# ── Module 6: Technology Intelligence ──────────────────────────────────────────
# OpenAlex polite pool
OPENALEX_MAILTO=your_email@example.com

# Semantic Scholar API Key (optional — improves rate limits)
# Get key at: https://api.semanticscholar.org/
SEMANTIC_SCHOLAR_API_KEY=

# EPO Open Patent Services (optional — alternative patent source)
EPO_CLIENT_ID=
EPO_CLIENT_SECRET=

# Patent API URL (default: PatentsView — free, no key required)
PATENT_API_URL=https://api.patentsview.org/patents/query

# Module 6 Feature Flags
TECH_AUTO_SEED_DEMO=True
TECH_ANALYSIS_START_YEAR=2019
TECH_ANALYSIS_END_YEAR=2025
