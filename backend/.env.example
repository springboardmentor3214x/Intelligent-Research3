# =================================================================
# Environment Configuration
# =================================================================
APP_ENV=development

# ── Database ───────────────────────────────────────────────────────────────────
# PostgreSQL (production / staging)
DATABASE_URL=postgresql://postgres:password@localhost:5432/intelliresearch

# SQLite alternative for local development (no PostgreSQL required):
# DATABASE_URL=sqlite:///./intelliresearch.db

# ── Auth (Module 1 / Member 3) ────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-secret
JWT_SECRET_KEY=change-me-to-a-long-random-secret
ALGORITHM=HS256
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS & Frontend URLs ───────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
FRONTEND_URL=http://localhost:5173

# ── Google OAuth2 Authentication (Optional) ────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback

# ── Module 3 — Research Data Ingestion (OpenAlex) ──────────────────────────────
OPENALEX_MAILTO=your@email.com

# ── Funding Source APIs (Module 4 / Member 4) ──────────────────────────────────
NIH_REPORTER_BASE_URL=https://api.reporter.nih.gov/v2
GRANTS_GOV_BASE_URL=https://apply07.grants.gov/grantsws

# ── Ingestion Defaults ─────────────────────────────────────────────────────────
FUNDING_SYNC_DEFAULT_LIMIT=50
FUNDING_SYNC_TIMEOUT_SECONDS=30
FUNDING_SYNC_MAX_RETRIES=3
