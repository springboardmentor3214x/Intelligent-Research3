# =================================================================
# Environment Configuration — Sadashiv Intelligent Research Platform
# =================================================================
APP_ENV=development

# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/intelliresearch
# SQLite alternative for local testing:
# DATABASE_URL=sqlite:///./intelliresearch.db

# ── Auth & JWT (Module 1) ──────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-secret
JWT_SECRET_KEY=change-me-to-a-long-random-secret
ALGORITHM=HS256
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS & Frontend URLs ───────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
FRONTEND_URL=http://localhost:5173

# ── Google OAuth2 Authentication ───────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback

# ── Module 3 — Research Intelligence (OpenAlex, Crossref, ORCID) ───────────────
OPENALEX_MAILTO=researcher@example.com
CROSSREF_MAILTO=researcher@example.com
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
SEMANTIC_SCHOLAR_API_KEY=

# ── Module 4 — Funding Discovery APIs (NIH RePORTER, Grants.gov) ───────────────
NIH_REPORTER_BASE_URL=https://api.reporter.nih.gov/v2
GRANTS_GOV_BASE_URL=https://apply07.grants.gov/grantsws
FUNDING_SYNC_DEFAULT_LIMIT=50
FUNDING_SYNC_TIMEOUT_SECONDS=30
FUNDING_SYNC_MAX_RETRIES=3

# ── Module 5 — Patent Landscape (PatentsView, EPO) ────────────────────────────
PATENT_API_URL=https://api.patentsview.org/patents/query
PATENT_API_KEY=
EPO_CLIENT_ID=
EPO_CLIENT_SECRET=

# ── Module 6, 7 & 8 — AI Intelligence (Gemini AI, OpenAI GPT) ─────────────────
GEMINI_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=

# ── Analysis Window & Seeding ──────────────────────────────────────────────────
TECH_AUTO_SEED_DEMO=False
TECH_ANALYSIS_START_YEAR=2019
TECH_ANALYSIS_END_YEAR=2026
